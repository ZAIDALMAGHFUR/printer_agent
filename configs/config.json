{
  "server_port": 2349,
  "hospital_name": "RSU ASHAVIN",
  "publisher": "SIMRS Developer Team",
  "auto_save_pdf": true,
  "pdf_save_dir": "C:\\SIMRS_PDF",
  "queue_worker_count": 4,
  "timeout_sec": 5,
  "github_repo": "https://github.com/ZAIDALMAGHFUR/printer_agent",
  "auto_sync_interval_min": 60,
  "printers": {
    "Billing": {
      "name": "Billing",
      "type": "pdf",
      "target": "AutoSavePDF",
      "driver_type": "generic",
      "paper_size": "A4",
      "auto_cut": false
    },
    "BuktiRegistrasi": {
      "name": "BuktiRegistrasi",
      "type": "usb",
      "target": "EPSON LX-310",
      "driver_type": "generic",
      "paper_size": "A4",
      "auto_cut": false,
      "template": "bukti_pendaftaran"
    },
    "CetakAntrian": {
      "name": "CetakAntrian",
      "type": "usb",
      "target": "EPSON TM-T82X Receipt",
      "driver_type": "escpos",
